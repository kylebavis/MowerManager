<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Preview in .NET 11; remove to fall back to compiler-generated state machines. -->
    <Features>runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="TUnit" Version="1.81.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MowerManager\MowerManager.csproj" />
  </ItemGroup>

</Project>
