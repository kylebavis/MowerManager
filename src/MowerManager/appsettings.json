{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=mower.db"
  },
  "Husqvarna": {
    "AppKey": "",
    "AppSecret": ""
  },
  "Polling": {
    "IntervalSeconds": 300,
    "ConnectedIntervalSeconds": 1800,
    "HistoryDays": 30
  },
  "BatteryRule": {
    "Scope": "AnyArea",
    "ThresholdPercent": 20,
    "Action": "Pause"
  },
  "Pushover": {
    "AppToken": "",
    "UserKey": "",
    "Priority": 0
  }
}
