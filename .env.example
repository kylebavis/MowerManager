Husqvarna__AppKey=
Husqvarna__AppSecret=
Pushover__AppToken=
Pushover__UserKey=

# Local accounts: first admin is created on startup when no users exist.
Auth__Local__InitialAdminUsername=admin
Auth__Local__InitialAdminPassword=

# OIDC (optional). For no login screen at all: Local__Enabled=false + AutoRedirect=true.
# Redirect URI to register: https://mower.example.com/signin-oidc
# Post-logout redirect URI: https://mower.example.com/signout-callback-oidc
#Auth__Local__Enabled=false
#Auth__Oidc__Enabled=true
#Auth__Oidc__AutoRedirect=true
#Auth__Oidc__Authority=https://auth.example.com/application/o/mower/
#Auth__Oidc__ClientId=
#Auth__Oidc__ClientSecret=
#Auth__Oidc__DisplayName=Authentik
#Auth__Oidc__AllowedEmails__0=you@example.com

# Required behind a TLS-terminating reverse proxy so redirects use https.
#ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
